    <!-- Régimen especial -->
    <string name="regime_title">Recompensas por extorsión y sicariato</string>
    <string name="regime_decree">D. S. N.º 097-2025-PCM</string>
    <string name="regime_intro">Régimen especial aprobado por el D. S. N.º 097-2025-PCM. Da beneficios económicos a quien brinde información útil para capturar a implicados en extorsión y sicariato.</string>
    <string name="regime_1_title">Pago acelerado</string>
    <string name="regime_1_body">El pago se hace en hasta 32 días hábiles.</string>
    <string name="regime_2_title">Protección del informante</string>
    <string name="regime_2_body">Tu anonimato y confidencialidad se protegen mediante una clave reservada.</string>
    <string name="regime_3_title">Procedimiento estructurado</string>
    <string name="regime_3_body">Recepción, verificación, formulación del expediente, evaluación y pago.</string>
    <string name="regime_4_title">Criterios claros</string>
    <string name="regime_4_body">El monto depende del nivel de participación del colaborador en la captura.</string>
    <string name="regime_5_title">Coordinación institucional</string>
    <string name="regime_5_body">La DIRNIC de la PNP trabaja con la Comisión Evaluadora de Recompensas contra la Criminalidad.</string>
    <string name="regime_closing">Tu recompensa puede ser hasta S/ 500 000</string>
    <string name="regime_open_official">Ver el comunicado oficial</string>
    <string name="regime_unofficial">Resumen hecho por una app no oficial. Lo que vale es el decreto y el Mininter.</string>
    <string name="report_safety">No te acerques a la persona.</string>
    <string name="settings_project">Sobre este proyecto</string>
    <string name="about_title">Sobre este proyecto</string>
    <string name="about_motto">Si todos estamos atentos, nadie se escapa.</string>
    <string name="about_why_title">Por qué existe</string>
    <string name="about_why_body">La web oficial del Programa de Recompensas tiene la información, pero no es fácil revisarla desde el celular. Esta app la ordena en carteles claros, fáciles de consultar y de compartir.</string>
    <string name="about_community_title">Una comunidad atenta</string>
    <string name="about_community_body">Queremos que mucha gente conozca estos rostros. Si alguien reconoce a una persona buscada, avisa a la línea gratuita y la Policía hace la captura. Nunca te acerques.</string>
    <string name="about_future_title">Hacia dónde vamos</string>
    <string name="about_future_body">Queremos ser una fuente de datos al día y fáciles de consultar que ayude a ubicar más rápido a las personas buscadas. Los datos vienen directamente de la web oficial del Programa de Recompensas.</string>
    <string name="about_support_title">Cómo apoyar</string>
    <string name="about_support_body">Los anuncios ayudan al mantenimiento y crecimiento del proyecto. Compartir la app y los carteles también suma. Agradecemos cualquier comentario u observación para seguir mejorando.</string>
    <string name="about_share_app">Compartir la app</string>
    <string name="about_rate">Calificar y comentar</string>
    <string name="about_share_text">Cazadores Perú: consulta a las personas buscadas por el Programa de Recompensas y comparte sus carteles. Si todos estamos atentos, nadie se escapa. %1$s</string>
</resources>
