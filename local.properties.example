# Copia este archivo a local.properties (no versionado).
sdk.dir=/Users/<usuario>/Library/Android/sdk

# IDs reales de AdMob para release. Sin ellos, el release usa los IDs de prueba de Google.
ADMOB_APP_ID_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
ADMOB_BANNER_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

# Firma de release (clave de subida a Play). El .jks va fuera del repo; ver D22 en docs/DECISIONES.md.
# Sin estas claves, el release se firma con la clave de debug (Play lo rechaza).
RELEASE_STORE_FILE=/Users/<usuario>/.config/cazadores-signing/upload-keystore.jks
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=upload
RELEASE_KEY_PASSWORD=
