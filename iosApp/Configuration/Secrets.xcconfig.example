// Copia este archivo a Secrets.xcconfig (no versionado) y completa los IDs reales de AdMob.
// Sin este archivo, la app usa los IDs de prueba públicos de Google.
// [config=Release] evita servir anuncios reales en Debug (AdMob prohíbe tocar los propios).
ADMOB_APP_ID_IOS[config=Release]=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
ADMOB_BANNER_IOS[config=Release]=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
